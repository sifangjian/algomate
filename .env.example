# Algomate 部署环境变量示例
# 复制为 .env 后按需修改（.env 不入库，已被 .dockerignore 忽略）

# 对外映射端口（宿主机反向代理访问用）
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 时区
TZ=Asia/Shanghai

# 数据库路径（容器内，与 data 挂载一致）
ALGOMATE_DB_PATH=/app/data/algomate.db

# 如需覆盖默认配置，可在此追加后端识别的环境变量
# APP_ENV=production

# 前端调用的后端地址（容器内 compose 网络，服务名为 backend）
# compose 已默认注入 http://backend:8000，通常无需改；
# 仅当后端服务名/端口变更时调整。
# VITE_API_URL=http://backend:8000


{
  "manifest_version": 3,
  "name": "AlgoMate LeetCode 一键导入",
  "version": "0.1.0",
  "description": "在 LeetCode 题目页抓取题目信息，预览并一键导入到本地 AlgoMate 系统",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "https://leetcode.cn/*",
    "https://leetcode.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 AlgoMate 侧边栏"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}

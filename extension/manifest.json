{
  "manifest_version": 3,
  "name": "AlgoMate LeetCode 一键导入",
  "version": "0.1.0",
  "description": "在 LeetCode 题目页右侧固定面板，抓取题目信息并一键导入到本地 AlgoMate 系统",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://leetcode.cn/*",
    "https://leetcode.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开/关闭 AlgoMate 导入面板（右侧）"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.cn/*", "https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
